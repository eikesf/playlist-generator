# Copy to .env (never committed) or put these in the "env" block of the Claude Desktop config.
# All are optional: `apple-music-mcp login` stores credentials in
# ~/.config/apple-music-mcp/credentials.json (chmod 600) instead.

# media-user-token cookie from a signed-in music.apple.com session
APPLE_MUSIC_USER_TOKEN=
# Web-player developer JWT. Leave empty: it is scraped automatically.
APPLE_MUSIC_DEVELOPER_TOKEN=
# Two-letter storefront (br, us, pt...). Leave empty to use your account's.
APPLE_MUSIC_STOREFRONT=
# Where credentials are stored (default ~/.config/apple-music-mcp)
APPLE_MUSIC_MCP_CONFIG_DIR=
# Optional free key from https://getsongbpm.com/api for better BPM data
GETSONGBPM_API_KEY=
