# apple-music-mcp configuration. Copy this file to ~/.config/apple-music-mcp/.env and fill what you use.
# The real .env is never committed. Everything is optional; empty means "use the default".
# Secrets do NOT go here: `apple-music-mcp login` puts the Apple Music token in the macOS Keychain,
# and `apple-music-mcp set-bpm-key` does the same for the GetSongBPM key.

# --- Apple Music ----------------------------------------------------------------
# Two-letter storefront (br, us, pt...). Empty: your account's.
APPLE_MUSIC_STOREFRONT=
# Kill switch: false = never call the Apple web-player API (catalog search uses iTunes Search only).
APPLE_WEB_API_ENABLED=true
# Time zone for schedules.
TIMEZONE=America/Sao_Paulo

# --- Notifications and dead man's switch (free services) -------------------------
# ntfy topic: pick a long random name and subscribe to it in the ntfy iPhone app. Treat it as a secret.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# healthchecks.io ping URL of your check (https://hc-ping.com/<uuid>).
HEALTHCHECK_URL=
# Optional healthchecks.io read-write API key, only used to pause/resume the check (`pause` command).
HEALTHCHECKS_API_KEY=

# --- Schedules (local time, HH:MM) -------------------------------------------------
# Recently-played collection; comma-separated (Apple keeps only the last ~50 songs).
RECENT_PLAYED_TIMES=10:30,22:30
SNAPSHOT_TIME=23:40
DOCTOR_TIME=08:10
BACKUP_TIME=23:50
HEARTBEAT_MINUTES=10

# --- Backups -------------------------------------------------------------------------
# Empty: iCloud Drive/apple-music-mcp-backups. Keeps 7 daily + 4 weekly copies.
BACKUP_DIR=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Behaviour defaults (chat preferences override these) ----------------------------
KNOWN_MIN_PLAYS=10
REFRESH_AUTO_APPLY=false
TOKEN_REMINDER_DAYS=7

# --- Weekly refresh (proposals the owner approves in a conversation) ------------------
# Default slot for playlists with the refresh on (each playlist can override it in chat).
# After changing it, run `apple-music-mcp schedule install` again.
REFRESH_WEEKDAY=monday
REFRESH_TIME=09:00
# Window of play/skip history used as evidence, and how much history is needed before any rotation.
REFRESH_WINDOW_DAYS=42
REFRESH_MIN_HISTORY_DAYS=14
# Tracks added to a playlist in the last N days are never rotated out.
REFRESH_MIN_DAYS_IN_PLAYLIST=14
# "Often skipped": at least this many skips in the window and this share of skips (0-1).
REFRESH_MIN_SKIPS=3
REFRESH_SKIP_RATIO=0.5
# Undecided proposals expire after N days; the next run makes a fresh one.
PROPOSAL_TTL_DAYS=7

# --- Weekly Discoveries (curated by Claude in a Desktop scheduled task) -----------------
# Target size of the weekly batch; batches between 2/3 and 4/3 of it are accepted.
DISCOVERIES_SIZE=30
# "Liked" = loved, or played at least PROMOTE_MIN_PLAYS times with a skip ratio below the maximum.
PROMOTE_MIN_PLAYS=3
PROMOTE_MAX_SKIP_RATIO=0.25
# Weekly cap: this share of the main playlist (rounded down), never above 30 tracks (guide §7.11).
PROMOTE_WEEKLY_FRACTION=0.2
PROMOTE_WEEKLY_MAX=30

# --- Advanced ----------------------------------------------------------------------
# Force where secrets are stored: keychain or file (default: keychain when available).
APPLE_MUSIC_MCP_SECRET_BACKEND=
